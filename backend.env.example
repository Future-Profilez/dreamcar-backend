# ==============================================================================
# DreamCar Backend Environment Configuration (.env.example)
# ==============================================================================
# Instructions:
# Duplicate this file and rename it to `.env` in the root of the backend directory.
# Fill in your production credentials and secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5003
NODE_ENV=production
# Base URL where your backend is publicly accessible (no trailing slash)
DOMAIN=https://api.yourdomain.com
BACKEND_PUBLIC_URL=https://api.yourdomain.com

# URL of your frontend application (used for CORS and email redirect links)
FRONTEND_URL=https://yourdomain.com

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / Neon DB)
# ------------------------------------------------------------------------------
# For Neon DB Cloud (Recommended):
# DATABASE_URL="postgresql://<user>:<password>@<neon-host>/neondb?sslmode=require&channel_binding=require"
# For Self-hosted PostgreSQL:
# DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?schema=public"
DATABASE_URL="postgresql://username:password@localhost:5432/dreamcar_db?schema=public"

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Generate a long, random secret key (e.g. openssl rand -base64 32)
JWT_SECRET_KEY="your_secure_jwt_secret_key_here"
JWT_EXPIRES_IN="24h"

# Cloudflare Turnstile Secret Key (Backend verification of Turnstile token)
CF_TURNSTILE_SECRET_KEY="your_cloudflare_turnstile_secret_key"

# ------------------------------------------------------------------------------
# 4. Stripe Payment Gateway
# ------------------------------------------------------------------------------
# Secret Key (sk_live_... for production, sk_test_... for test mode)
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"

# Publishable Key (pk_live_... for production, pk_test_... for test mode)
STRIPE_TEST_KEY="pk_live_your_stripe_publishable_key"

# Stripe Webhook Signing Secret (Obtained after creating the webhook endpoint in Stripe Dashboard)
# Webhook URL to register in Stripe: https://<your-backend-domain>/api/stripe/webhook
# Required Events:
#  - checkout.session.completed
#  - checkout.session.expired
#  - checkout.session.async_payment_failed
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"

# ------------------------------------------------------------------------------
# 5. SMTP / Email Configuration (Nodemailer)
# ------------------------------------------------------------------------------
# Supports any SMTP provider (e.g., SendGrid, Amazon SES, Google Workspace, Postmark)
SMTP_HOST="smtp.your-email-provider.com"
SMTP_PORT=587
SMTP_USER="your-email@yourdomain.com"
SMTP_PASS="your_smtp_app_password"

# ------------------------------------------------------------------------------
# 6. Klaviyo Marketing & Audience Lists
# ------------------------------------------------------------------------------
# Klaviyo Private API Key (pk_...)
KLAVIYO_PRIVATE_API_KEY="pk_your_klaviyo_private_api_key"

# Klaviyo List IDs (6-character alphanumeric IDs from your Klaviyo lists)
WEBSITE_NEWSLETTER_KLAVIYO_LIST_ID="your_newsletter_list_id"
WEBSITE_CONTACT_FORM_KLAVIYO_LIST_ID="your_contact_form_list_id"

# ------------------------------------------------------------------------------
# 7. Cloud Storage (Optional - if using AWS S3 / DigitalOcean Spaces for uploads)
# ------------------------------------------------------------------------------
# AWS S3 (if applicable):
# AWS_REGION="eu-west-2"
# AWS_ACCESS_KEY_ID="your_aws_access_key"
# AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
# S3_BUCKET_NAME="dreamcar-uploads"

# DigitalOcean Spaces (if applicable):
# DO_SPACE_ENDPOINT="ams3.digitaloceanspaces.com"
# DO_SPACE_REGION="ams3"
# DO_SPACE_BUCKET_NAME="your-space-name"
# DO_SPACE_ACCESS_KEY="your_spaces_access_key"
# DO_SPACE_SECRET_KEY="your_spaces_secret_key"
